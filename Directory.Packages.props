<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>
  <!-- libclang natives for the generator (generate/Generate.cs). Their major must match the LLVM
       install whose builtin headers the generator passes as the clang resource directory. -->
  <ItemGroup>
    <PackageVersion Include="libclang.runtime.win-x64" Version="22.1.8" />
    <PackageVersion Include="libclang.runtime.linux-x64" Version="22.1.8" />
    <PackageVersion Include="libclang.runtime.osx-arm64" Version="22.1.8" />
    <PackageVersion Include="libClangSharp.runtime.win-x64" Version="22.1.8.2" />
    <PackageVersion Include="libClangSharp.runtime.linux-x64" Version="22.1.8.2" />
    <PackageVersion Include="libClangSharp.runtime.osx-arm64" Version="22.1.8.2" />
  </ItemGroup>
</Project>
