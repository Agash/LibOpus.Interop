<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Opus.Interop</RootNamespace>
    <!-- The shipped library runs the recommended rule set as errors; tests stay on the default set. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- IsAotCompatible only runs the analyzers on this project; this also checks that everything
         it references is annotated compatible. -->
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <IsPackable>true</IsPackable>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>Opus.Interop</PackageId>
    <Description>.NET bindings for libopus 1.6: an Opus encoder and decoder with every control typed (bitrate, complexity, in-band FEC, DTX, bandwidth, signal), packet inspection, and float, 16-bit and 24-bit PCM, over complete source-generated bindings to libopus. Ships libopus for Windows, Linux and macOS on x64 and arm64. Allocation-free on the encode and decode paths, Native AOT compatible.</Description>
    <PackageTags>opus;libopus;audio;codec;encoder;decoder;voip;webrtc;interop;bindings;aot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="all" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <!-- Every change to the public surface shows in PublicAPI.Unshipped.txt, so it is reviewed. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <InternalsVisibleTo Include="Opus.Interop.Tests" />
  </ItemGroup>
  <!-- The native library from eng/build-native.ps1: every runtime CI built goes into the package, and
       this machine's is copied beside the output of whatever references the project. -->
  <ItemGroup>
    <!-- A directory PackagePath gets the item's RecursiveDir (<rid>/native/) appended by NuGet. -->
    <None
      Include="..\..\artifacts\native\**\*opus-interop.*"
      Pack="true"
      PackagePath="runtimes"
      Visible="false"
    />
    <None
      Include="..\..\artifacts\native\LICENSE.opus.txt"
      Pack="true"
      PackagePath=""
      Condition="Exists('..\..\artifacts\native\LICENSE.opus.txt')"
      Visible="false"
    />
    <None
      Include="..\..\artifacts\native\$(NETCoreSdkRuntimeIdentifier)\native\*"
      CopyToOutputDirectory="PreserveNewest"
      Link="%(Filename)%(Extension)"
      Pack="false"
      Visible="false"
    />
  </ItemGroup>
</Project>
